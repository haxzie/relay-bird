# Committed on purpose. The PostHog project token is write-only and is shipped to every
# browser that loads the site, so it is not a secret — and NEXT_PUBLIC_* values are inlined
# at build time, which means CI needs them present during `next build`, not just at runtime.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_sKiYRQsAL3pugYopHYdRUTobA47GcqPgLgDXzUsUFVfS
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Set once you have a GA4 measurement ID (G-XXXXXXXXXX). Google Analytics stays off until
# then; nothing else changes.
NEXT_PUBLIC_GA_ID=G-VJK7QGZL73
