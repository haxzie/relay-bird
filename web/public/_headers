# Next's build output is content-hashed, so it can be cached forever. Cloudflare's default for
# static assets is max-age=0 + must-revalidate, which would mean a conditional request per file
# per visit for files that by construction never change.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Not content-hashed, so a day rather than a year — long enough to stop refetching it on
# every visit, short enough that replacing it actually takes effect.
/wallpaper.webp
  Cache-Control: public, max-age=86400
