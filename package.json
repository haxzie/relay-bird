{
  "name": "relaybird",
  "version": "1.0.0",
  "private": true,
  "description": "Mirror Android SMS to a macOS menu bar app over the local network",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --sequential run build",
    "test": "pnpm -r --sequential run test",
    "clean": "pnpm -r --sequential run clean && rm -rf dist",
    "release": "pnpm -r --sequential run release",
    "android": "pnpm --filter @relaybird/android run",
    "macos": "pnpm --filter @relaybird/macos run",
    "dev:android": "pnpm --filter @relaybird/android run install-device",
    "dev:macos": "pnpm --filter @relaybird/macos run start",
    "device-test": "pnpm --filter @relaybird/android run device-test",
    "logs": "pnpm --filter @relaybird/android run logs"
  }
}
